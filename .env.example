# --------------------------------------------------------------------------- #
# Copy this file to .env and adjust the values:  cp .env.example .env
# --------------------------------------------------------------------------- #

# Ports exposed on the host
FRONTEND_PORT=8080
BACKEND_PORT=8000
MLFLOW_PORT=5000

# PostgreSQL (used by the MLflow Model Registry - a SQL store is required)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# Inference engine: auto | onnx | ultralytics
#   auto        -> ONNX when best.onnx exists, otherwise the .pt checkpoint
#   onnx        -> ONNX Runtime only (the production path)
#   ultralytics -> PyTorch only
PPE_BACKEND=auto

# Detection thresholds (the frontend can override them per request)
PPE_CONF=0.25
PPE_IOU=0.45

# Training / evaluation
PPE_BASE_MODEL=yolo11n.pt
PPE_EPOCHS=30
PPE_BATCH=12
PPE_DEVICE=cuda
PPE_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
PPE_MLFLOW_EXPERIMENT=ppe-detection
PPE_MLFLOW_RUN_NAME=yolo11n_30ep

# Frontend build (relative path -> same origin through the nginx proxy)
VITE_API_URL=/api
